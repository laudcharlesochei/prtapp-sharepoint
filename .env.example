# Copy to .env for local runs (`heroku local` reads it). Never commit .env.
SHAREPOINT_AUTH_MODE=delegated
AZURE_TENANT_ID=dundee.ac.uk
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=paste-client-secret-value-here
SHAREPOINT_SITE_URL=https://dmail.sharepoint.com/sites/MentorMeetingSystem
SHAREPOINT_LIST=employee
SHAREPOINT_FIELD_FIRST_NAME=FirstName
SHAREPOINT_FIELD_LAST_NAME=LastName
SHAREPOINT_FIELD_EMAIL=Email
SHAREPOINT_TITLE_FROM=email
